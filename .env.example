# Copy to .env and supply your own service credentials and endpoints.
# Never commit .env. Existing process variables take precedence over .env.
# Numeric and concurrency settings are applied by config/experiment.json
# when using run_experiment.py.

# Advanced OpenAI-compatible LLM: group drafts, feedback and type integration.
LLM_API_KEY=""
LLM_API_BASE_URL=""
LLM_MODEL="deepseek-v4-flash"

# Basic LLM: proposition extraction and group naming.
# Both profiles can use the same model and service credentials.
LLM_BASIC_API_KEY=""
LLM_BASIC_API_BASE_URL=""
LLM_BASIC_MODEL="deepseek-v4-flash"

# Literature search adapter: see README.md for the required API contract.
LITERATURE_SEARCH_API_KEY=""
LITERATURE_SEARCH_API_ENDPOINT=""
LITERATURE_SEARCH_TYPE="semantic"
LITERATURE_API_VERIFY_SSL="true"

# OpenAI-compatible embeddings.
EMBEDDING_API_KEY=""
EMBEDDING_API_BASE_URL=""
EMBEDDING_MODEL="text-embedding-v4"
